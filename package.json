{
  "name": "nova-minecraft-launcher",
  "productName": "Nova Launcher",
  "version": "1.0.0",
  "description": "Кастомизируемый Minecraft-лаунчер с офлайн-профилями, Modrinth и CurseForge",
  "main": "main.js",
  "author": "Nova",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis",
    "dist:all": "electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nova.launcher",
    "productName": "Nova Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "core/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "NovaLauncher-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Launcher"
    },
    "portable": {
      "artifactName": "NovaLauncher-${version}-portable.exe"
    },
    "compression": "maximum"
  }
}
